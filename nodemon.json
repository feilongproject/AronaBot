{
    "ignore": [
        ".git",
        "node_modules/**/node_modules",
        "src/plugins/",
        "config/opts.ts",
        "config/settings.json",
        "config/settings.*.tmp",
        "config/*.tmp"
    ],
    "execMap": {
        "ts": "tsc"
    },
    "watch": [
        "config/",
        "src/init.ts",
        "src/index.ts",
        "src/handlerSync.ts",
        "src/libs/",
        "src/types/",
        "src/web/"
    ],
    "exec": "tsx -r dotenv/config src/index.ts --dev",
    "ext": "ts,json"
}
